{
  "entity": {
    "sensor": {
      "charging_state": {
        "default": "mdi:battery",
        "state": {
          "unplugged": "mdi:battery-minus",
          "charging": "mdi:battery-charging",
          "plugged_in": "mdi:power-plug-battery"
        }
      },
      "motion_status": {
        "default": "mdi:car",
        "state": {
          "parked": "mdi:car-off",
          "driving": "mdi:car-side"
        }
      },
      "speech_language": {
        "default": "mdi:translate"
      }
    },
    "select": {
      "volume": {
        "default": "mdi:volume-high",
        "state": {
          "silent": "mdi:volume-off",
          "low": "mdi:volume-low",
          "normal": "mdi:volume-medium",
          "hard": "mdi:volume-high"
        }
      },
      "brightness": {
        "default": "mdi:brightness-6"
      },
      "led_orientation": {
        "default": "mdi:rotate-3d-variant",
        "state": {
          "normal": "mdi:rotate-3d-variant",
          "upside_down": "mdi:rotate-3d"
        }
      }
    },
    "event": {
      "red_button": {
        "default": "mdi:gesture-tap-button"
      },
      "blue_button": {
        "default": "mdi:gesture-tap-button"
      }
    }
  },
  "services": {
    "play_animation": {
      "service": "mdi:led-strip"
    },
    "play_progress": {
      "service": "mdi:led-strip-variant"
    }
  }
}
